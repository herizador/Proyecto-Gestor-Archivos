# Copia a .env.local para desarrollo. En Vercel: Project → Settings → Environment Variables.

# Supabase (públicas; también en el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Cloudflare R2 (solo servidor; no uses NEXT_PUBLIC_)
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=gestor-archivos-familia

# Service-role de Supabase (solo servidor, secreto: necesario para /api/subir,
# que valida tokens sin sesión de navegador; también en Vercel)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (obligatoria en producción/Vercel: es la base de los
# enlaces de /compartir; p. ej. https://tu-app.vercel.app). En local se usa
# http://localhost:3000 si no se define.
